<?xml version="1.0" encoding="UTF-8"?>
<!-- The browser commands used by this addon, from Safari.sdef.
     Keep the input local so builds do not require an installed browser.
     Safari accepts a document or tab for "in"; this addon always uses a tab. -->
<dictionary>
  <suite name="Standard Suite" code="core">
    <class name="application" code="capp">
      <element type="window"/>
    </class>
    <class name="window" code="cwin">
      <element type="tab"/>
      <property name="current tab" code="cTab" type="tab" access="r">
        <cocoa key="currentTabViewItem"/>
      </property>
    </class>
    <class name="tab" code="bTab"/>
  </suite>
  <suite name="Safari suite" code="sfri">
    <command name="do JavaScript" code="sfridojs">
      <direct-parameter type="text"/>
      <parameter name="in" code="dcnm" type="tab"/>
      <result type="any"/>
    </command>
  </suite>
</dictionary>
